# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=intrak_db
DATABASE_URL=postgresql://postgres:secure_password_here@db:5432/intrak_db?schema=public

# Security Secrets (Generate random strings for these)
JWT_SECRET=replace_with_long_random_string_1
JWT_REFRESH_SECRET=replace_with_long_random_string_2

# Server Configuration
PORT=5000
NODE_ENV=production

# URLs (Important for CORS and Cookies)
# For local RPi access (optional)
# CORS_ORIGIN=https://intrak.site,http://localhost:8080
# For Production
CORS_ORIGIN=https://intrak.site
CLIENT_URL=https://intrak.site

# Cloudflare Tunnel Token (Required for public access)
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# NAS Configuration (RPi Docker Specific)
USE_NAS=true
NAS_PATH=/mnt/nas/intrak
# Optional: how often local → NAS sync runs (default */30 * * * *)
# NAS_SYNC_CRON=*/30 * * * *
# NAS_HEALTH_CRON=*/2 * * * *
# After files are verified on NAS, remove matching local copies older than N days (default 15)
LOCAL_NAS_STAGING_RETENTION_DAYS=15
# Cron for staging cleanup (default daily 03:00)
LOCAL_NAS_STAGING_CLEANUP_CRON=0 3 * * *
# Set to false to skip staging cleanup entirely
LOCAL_NAS_STAGING_CLEANUP_ENABLED=true

# Email Service (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=INTRAK System
