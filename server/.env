# JWT Secrets (REQUIRED for authentication)
JWT_SECRET="intrak-super-secret-jwt-key-2025-development-only"
JWT_REFRESH_SECRET="intrak-super-secret-refresh-key-2025-development-only"
JWT_EXPIRE="15m"
JWT_REFRESH_EXPIRE="7d"

# Email Configuration (Optional for development)
