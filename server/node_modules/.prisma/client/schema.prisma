// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORDINATOR
  INSTRUCTOR
  STUDENT
  INDUSTRY_PARTNER
}

enum DocumentType {
  APPLICATION_LETTER
  MOA
  ACCEPTANCE
  EVALUATION_FORM
  DTR_HARDCOPY
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationMethod {
  MANUAL
  QR
  GPS
  IP
  FACIAL
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  COORDINATORS
  INSTRUCTORS
  PARTNERS
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  profilePhoto String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  student              Student?
  studentsAssigned     Student[]          @relation("InstructorStudents") // Students assigned to this instructor
  documentsUploaded    Document[]         @relation("DocumentUploader")
  evaluationsGiven     Evaluation[]       @relation("Evaluator")
  announcementsCreated Announcement[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  templatesUploaded    DocumentTemplate[] @relation("TemplateUploader")
  notifications        Notification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Student {
  id             String    @id @default(uuid())
  userId         String    @unique
  studentNumber  String    @unique
  program        String
  year           Int
  section        String
  companyId      String?
  supervisorName String?
  instructorId   String? // New field for instructor assignment
  startDate      DateTime?
  endDate        DateTime?
  totalHours     Int       @default(240)
  completedHours Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company?        @relation(fields: [companyId], references: [id])
  instructor     User?           @relation("InstructorStudents", fields: [instructorId], references: [id])
  documents      Document[]
  attendanceLogs AttendanceLog[]
  evaluations    Evaluation[]
  notifications  Notification[]

  @@map("students")
}

model Company {
  id            String   @id @default(uuid())
  name          String
  address       String
  contactPerson String
  contactEmail  String
  contactNumber String
  latitude      Float?
  longitude     Float?
  radiusMeters  Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  students Student[]

  @@map("companies")
}

model Document {
  id           String         @id @default(uuid())
  studentId    String
  type         DocumentType
  filename     String
  filepath     String
  mimeType     String
  status       DocumentStatus @default(PENDING)
  remarks      String?
  uploadedById String
  uploadedAt   DateTime       @default(now())
  reviewedAt   DateTime?

  // E-signature fields (future feature - disabled)
  requiresSignature Boolean   @default(false)
  signedAt          DateTime?
  signatureData     String?

  // Relations
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@map("documents")
}

model AttendanceLog {
  id                   String             @id @default(uuid())
  studentId            String
  date                 DateTime
  timeIn               DateTime?
  timeOut              DateTime?
  durationMinutes      Int                @default(0)
  verified             Boolean            @default(false)
  verificationMethod   VerificationMethod @default(MANUAL)
  verificationMetadata Json?
  remarks              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("attendance_logs")
}

model QRToken {
  id        String    @id @default(uuid())
  token     String    @unique
  studentId String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("qr_tokens")
}

model Evaluation {
  id            String   @id @default(uuid())
  studentId     String
  evaluatorId   String
  evaluatorRole String
  rating        Float
  criteria      Json?
  comments      String?
  createdAt     DateTime @default(now())

  // Relations
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluator User    @relation("Evaluator", fields: [evaluatorId], references: [id])

  @@map("evaluations")
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  content     String
  audience    AnnouncementAudience @default(ALL)
  views       Int                  @default(0)
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relations
  createdBy User @relation(fields: [createdById], references: [id])

  @@map("announcements")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  meta      Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model DocumentTemplate {
  id           String       @id @default(uuid())
  name         String
  description  String?
  type         DocumentType
  filename     String
  filepath     String
  mimeType     String
  isActive     Boolean      @default(true)
  uploadedById String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  uploadedBy User @relation("TemplateUploader", fields: [uploadedById], references: [id])

  @@map("document_templates")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // 'document', 'attendance', 'evaluation', 'system'
  title     String
  message   String
  read      Boolean   @default(false)
  readAt    DateTime?
  studentId String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
