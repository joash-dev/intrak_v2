# ===========================================
# INTRAK environment variables (example)
# ===========================================
# Copy this file to .env and fill in real values.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=intrak_db
DATABASE_URL=postgresql://postgres:changeme@db:5432/intrak_db?schema=public

# --- Security ---
JWT_SECRET=replace_with_long_random_string_1
JWT_REFRESH_SECRET=replace_with_long_random_string_2

# --- Server ---
PORT=5000
NODE_ENV=production

# --- URLs / CORS ---
CORS_ORIGIN=https://intrak.site
CLIENT_URL=https://intrak.site

# --- Redis (login rate limiting) ---
# In Docker Compose this resolves to the `redis` service.
# Locally you can use redis://localhost:6379
REDIS_URL=redis://redis:6379

# --- Login rate limits (per 15-minute window) ---
# Per source IP (network-edge brute-force protection)
LOGIN_IP_MAX=20
# Per account email (credential-stuffing protection across IPs)
LOGIN_ACCOUNT_MAX=10

# --- Email (Resend) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@intrak.site
RESEND_FROM_NAME=INTRAK System

# --- NAS storage ---
USE_NAS=true
NAS_PATH=/mnt/nas/intrak
LOCAL_NAS_STAGING_RETENTION_DAYS=15
LOCAL_NAS_STAGING_CLEANUP_CRON=0 3 * * *
LOCAL_NAS_STAGING_CLEANUP_ENABLED=true
