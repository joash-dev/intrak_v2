# ===========================================
# INTRAK AWS EC2 Environment Configuration
# ===========================================
# Copy this to .env and fill in your values:
#   cp .env.aws.template .env
#   nano .env

# Database Configuration
PORT=5000
NODE_ENV=production
TZ=Asia/Manila

# --- Security ---
JWT_SECRET=intrakjwt!
JWT_REFRESH_SECRET=intrakjwt!@
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# --- Database (LOCAL RPi) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=intrak_database
POSTGRES_DB=intrak_db
DATABASE_URL=postgresql://postgres:intrak_database@db:5432/intrak_db?schema=public

# --- URLs & CORS ---
CORS_ORIGIN=https://intrak.site,https://www.intrak.site,http://localhost:8080
CLIENT_URL=https://intrak.site

# --- Email (RESEND) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_86vzzJrT_FDJWPP4VnwoR1bNHXcEU1BnB
RESEND_FROM_EMAIL=noreply@intrak.site
RESEND_FROM_NAME="INTRAK System"

# --- NAS Storage ---
USE_NAS=true
NAS_PATH=/mnt/nas/intrak
MAX_FILE_SIZE=10485760
ALLOWED_MIMETYPES=application/pdf,image/jpeg,image/png
